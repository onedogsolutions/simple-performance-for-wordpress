#: src/components/HardeningSettings.jsx:802
msgid "Root .htaccess Rules"
msgstr ""

#: src/components/HardeningSettings.jsx:806
msgid "Server-level rules written to the site root .htaccess via WordPress markers (your permalink rules are preserved). On OpenLiteSpeed these require “Allow Override” enabled for the vhost. A safety check automatically removes the rules if they cause a 500 error."
msgstr ""

#: src/components/HardeningSettings.jsx:812
msgid "Protect sensitive files"
msgstr ""

#: src/components/HardeningSettings.jsx:816
msgid "Blocks direct access to readme.html, license.txt, wp-config-sample.php, debug.log, .env, *.sql, *.bak, and *.old files. These commonly leak version info, credentials, and database dumps."
msgstr ""

#: src/components/HardeningSettings.jsx:832
msgid "Status"
msgstr ""

#: src/components/HardeningSettings.jsx:836
msgid "Integrity of the marker block in your root .htaccess."
msgstr ""

#: src/components/HardeningSettings.jsx:853
msgid "Site Hardening"
msgstr ""

#: src/components/HardeningSettings.jsx:857
msgid "Application-level protections that apply regardless of the web server configuration."
msgstr ""

#: src/components/HardeningSettings.jsx:863
msgid "Disable the theme & plugin file editor"
msgstr ""

#: src/components/HardeningSettings.jsx:867
msgid "Removes the built-in code editor under Appearance and Plugins (sets DISALLOW_FILE_EDIT), so an attacker who gains admin access cannot edit PHP directly from the dashboard."
msgstr ""

#: src/components/HardeningSettings.jsx:881
msgid "Block author enumeration"
msgstr ""

#: src/components/HardeningSettings.jsx:885
msgid "Redirects ?author=N and /author/slug/ probes from logged-out visitors to the home page, preventing usernames from being harvested for brute-force attacks. Also removes the users sitemap (wp-sitemap-users-1.xml) to close the same leak via sitemaps. Complements disabling the REST users endpoint."
msgstr ""

#: src/components/HardeningSettings.jsx:897
msgid "Disable Application Passwords"
msgstr ""

#: src/components/HardeningSettings.jsx:901
msgid "Removes the Application Passwords authentication method. These bypass two-factor authentication plugins. Warning: this will break any existing integration that authenticates with an application password. MainWP is unaffected — it uses its own signed channel."
msgstr ""

#: src/components/HardeningSettings.jsx:915
msgid "Disable XML-RPC"
msgstr ""

#: src/components/HardeningSettings.jsx:919
msgid "Disables the XML-RPC endpoint and pingback headers/methods."
msgstr ""

#: src/components/HardeningSettings.jsx:937
msgid "Block xmlrpc.php at server level"
msgstr ""

#: src/components/HardeningSettings.jsx:941
msgid "Layers a server-level 403 for xmlrpc.php on top of the PHP disable above — it does not replace it. When the vhost honors .htaccess the request is denied before PHP boots, turning a full WordPress bootstrap into a static denial (a performance win against brute-force and system.multicall floods); when .htaccess is inert the PHP disable still blocks XML-RPC, so you are never left unprotected. MainWP is unaffected — it uses its own signed HTTP channel, not XML-RPC."
msgstr ""

#: src/components/HardeningSettings.jsx:956
msgid "Generic login error messages"
msgstr ""

#: src/components/HardeningSettings.jsx:960
msgid "Replaces login and password-reset error messages with a single generic string, so attackers cannot determine whether a username exists. Real users see a less specific message."
msgstr ""

#: src/components/HardeningSettings.jsx:974
msgid "Send security headers"
msgstr ""

#: src/components/HardeningSettings.jsx:978
msgid "Adds X-Content-Type-Options: nosniff, X-Frame-Options: SAMEORIGIN, a Referrer-Policy, COOP, CORP, and a configurable Permissions-Policy to front-end responses. Conservative defaults with no side effects. Content-Security-Policy is configured separately below."
msgstr ""

